<Window x:Class="ProjectManagementBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ProjectManagementBoard.Controls"
        Title="Project Management Board" Height="800" Width="1320" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic" Foreground="{DynamicResource ThemeText}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">
    <!-- Custom title bar: no system caption; dragging/double-click/snap still come from WindowChrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" BorderBrush="#40000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleLeftColumn" Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Same tint and divider as the left panel below, so it reads as one column -->
                <Border Background="#2E000000" BorderBrush="{DynamicResource Fg14}" BorderThickness="0,0,1,0" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="{StaticResource AppLogo}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PM Board" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Current project + file actions (work on every page). Buttons must be hit-testable in the caption. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            ToolTip="왼쪽 패널 숨기기/보이기 (Ctrl+B)" Margin="0,0,10,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleLeftPanel_Click"/>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="13" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FileNameText" FontSize="13" Opacity="0.85" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <Border Width="1" Height="18" Background="{DynamicResource Fg33}" Margin="16,0,10,0"/>
                    <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" ToolTip="프로젝트 불러오기 (Ctrl+O)"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="불러오기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- The orange dot means there are unsaved changes -->
                    <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Margin="2,0,0,0"
                            ToolTip="프로젝트 저장 (Ctrl+S)" WindowChrome.IsHitTestVisibleInChrome="True" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="13"/>
                                <Ellipse x:Name="UnsavedDot" Width="7" Height="7" Fill="{StaticResource AccentOrange}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" Opacity="0"/>
                            </Grid>
                            <TextBlock x:Name="SaveLabel" Text="저장됨" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" FontSize="12" Padding="8,4" Margin="2,0,0,0"
                            ToolTip="다른 이름으로 저장 (Ctrl+Shift+S)" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="SaveAs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE792;" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="다른 이름으로 저장" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="최소화"
                            Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="최대화"
                            Click="MaximizeRestore_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="닫기"
                            Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: MENU (Group View) above the project list -->
                <Border x:Name="LeftPanel" Width="200" Background="#2E000000" BorderBrush="{DynamicResource Fg14}" BorderThickness="0,0,1,0" ClipToBounds="True">
                  <Grid Width="199" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Opacity="0.45" Margin="24,18,0,8"/>

                        <!-- Nav items; NavIndicator slides under the selected one (see SelectPage) -->
                        <Grid Margin="12,0">
                            <Border x:Name="NavIndicator" Height="44" VerticalAlignment="Top" CornerRadius="12" Background="{DynamicResource Fg26}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorShift"/>
                                </Border.RenderTransform>
                                <Border Width="3" HorizontalAlignment="Left" Margin="0,11" CornerRadius="1.5"
                                        Background="{StaticResource AccentOrange}"/>
                            </Border>
                            <StackPanel>
                                <Button x:Name="NavGroup" Style="{StaticResource NavButton}" Tag="&#xE80A;" Content="Group View"
                                        FontWeight="SemiBold" Opacity="1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Project list: every *.vad the app knows about, click to load, pencil to rename.
                         Drawn as its own darker panel so it reads as a separate area from the title bar above. -->
                    <Border Grid.Row="1" Margin="10,22,10,12" CornerRadius="16" Background="#24000000"
                            BorderBrush="{DynamicResource Fg14}" BorderThickness="1" Padding="0,12,0,4" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Section header: folder icon + PROJECTS + count -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,0,10,10">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="13" Opacity="0.75"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="PROJECTS" FontSize="11" FontWeight="Bold" Opacity="0.8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Actions: two dashed tiles side by side, then a hairline, so they can't be mistaken for projects -->
                            <StackPanel Grid.Row="1">
                                <Grid Margin="10,0,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE710;" Content="새 프로젝트"
                                            ToolTip="빈 프로젝트 파일을 만들어서 열기" Click="AddProject_Click"/>
                                                                        <Button Grid.Column="2" Style="{StaticResource ActionTile}" Tag="&#xE8E5;" Content="불러오기"
                                            ToolTip="저장된 프로젝트 파일(*.pmb) 불러오기 (Ctrl+O)" Click="Open_Click"/>
                                </Grid>
                                <Rectangle Height="1" Margin="14,0,14,8" Fill="{DynamicResource Fg1C}"/>
                            </StackPanel>

                        </Grid>
                    </Border>
                  </Grid>
                </Border>

                <!-- Board page -->
                <Grid Grid.Column="1">
                    <!-- Depth (design #21): two soft light blooms behind both pages — a pale one from the top-left and a
                         cool blue one from the bottom-right — so the flat navy gradient has some atmosphere. Visual only. -->
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.8" RadiusY="0.9">
                                <GradientStop Color="#1CFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.95,1" GradientOrigin="0.95,1" RadiusX="0.7" RadiusY="0.8">
                                <GradientStop Color="#1E5B8CFF" Offset="0"/>
                                <GradientStop Color="#005B8CFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="BoardPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top bar -->
                        <Grid x:Name="TopBar" Margin="32,20,28,8">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <StackPanel>
                                <TextBlock Text="Project Management Board" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SubtitleText" FontSize="12" Opacity="0.6" Margin="1,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                
                                <!-- Move mode: 자유이동 (follows the pointer) / 맞춤이동 (snaps to a grid) -->
                                <Border CornerRadius="14" Background="{DynamicResource Fg14}" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ModeFreeBack" CornerRadius="12">
                                            <Button x:Name="ModeFreeButton" Style="{StaticResource GhostButton}" Padding="10,3" Click="ModeFree_Click"
                                                ToolTip="자유이동: 마우스를 따라 자유롭게 움직여요 (Ctrl+G로 전환)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="자유이동" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        </Border>
                                        <Border x:Name="ModeSnapBack" CornerRadius="12">
                                            <Button x:Name="ModeSnapButton" Style="{StaticResource GhostButton}" Padding="10,3" Click="ModeSnap_Click"
                                                ToolTip="맞춤이동: 일정 간격(20)으로 끊어서 움직여서 정렬하기 쉬워요 (Ctrl+G로 전환)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="맞춤이동" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="PasteButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Visibility="Collapsed"
                                        ToolTip="복사한 관리 툴 붙여넣기 (Ctrl+V)" Click="Paste_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="붙여넣기" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" ToolTip="배경 색상 변경"
                                        Click="BackgroundColor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="BackgroundSwatch" Width="14" Height="14" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.5"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="배경 색" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" ToolTip="그룹 박스 추가 (새 그룹 · 저장해 둔 그룹 불러오기)"
                                        Click="AddGroup_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="15" Height="12" RadiusX="3" RadiusY="3" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.4"
                                                   StrokeDashArray="2 1.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="+ 그룹" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PillButton}" Content="+  새 관리 툴" ToolTip="새 관리 툴 (Ctrl+N)"
                                        Click="AddCard_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Viewport: the dot-grid background pans/zooms with the board (brush set in code) -->
                        <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True"
                              MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseMove="Viewport_MouseMove"
                              PreviewMouseRightButtonDown="Viewport_PreviewMouseRightButtonDown"
                              PreviewMouseRightButtonUp="Viewport_PreviewMouseRightButtonUp" LostMouseCapture="Viewport_LostMouseCapture"
                              PreviewMouseWheel="Viewport_PreviewMouseWheel">
                            <Canvas x:Name="Board" Focusable="True" FocusVisualStyle="{x:Null}">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="BoardScale"/>
                                        <TranslateTransform x:Name="BoardPan"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Grid>

                        <!-- Hide/show the top bar: a small tab centered on the top edge of the board -->
                        <Button x:Name="TopBarToggle" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Click="ToggleTopBar_Click" ToolTip="위쪽 바 숨기기/보이기" Cursor="Hand" Panel.ZIndex="5"
                                FocusVisualStyle="{x:Null}" Foreground="{DynamicResource ThemeText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="44" Height="16" CornerRadius="0,0,8,8" Background="{DynamicResource Fg14}">
                                        <TextBlock x:Name="Chevron" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                                                   RenderTransformOrigin="0.5,0.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fg33}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Vignette (design #3): the board edges fall off to a darker navy, drawing the eye to the center.
                             Purely visual; mouse input passes through to the board. -->
                        <Border Grid.Row="1" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Color="#00081230" Offset="0.55"/>
                                    <GradientStop Color="#40081230" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel x:Name="EmptyHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Opacity="0">
                            <!-- Line illustration (design #6): a dashed group box holding a card outline, with a "+" badge -->
                            <Canvas Width="150" Height="104" HorizontalAlignment="Center" Margin="0,0,0,18" Opacity="0.85">
                                <Rectangle Canvas.Left="6" Canvas.Top="8" Width="138" Height="90" RadiusX="20" RadiusY="20"
                                           Stroke="{DynamicResource ThemeText}" StrokeThickness="1.6" StrokeDashArray="4 3.5" Opacity="0.45"/>
                                <Rectangle Canvas.Left="30" Canvas.Top="26" Width="90" Height="62" RadiusX="12" RadiusY="12"
                                           Stroke="{DynamicResource ThemeText}" StrokeThickness="2" Fill="{DynamicResource Fg14}"/>
                                <Rectangle Canvas.Left="42" Canvas.Top="38" Width="40" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource ThemeText}" Opacity="0.85"/>
                                <Rectangle Canvas.Left="42" Canvas.Top="52" Width="66" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeText}" Opacity="0.4"/>
                                <Rectangle Canvas.Left="42" Canvas.Top="62" Width="54" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeText}" Opacity="0.4"/>
                                <Rectangle Canvas.Left="42" Canvas.Top="72" Width="30" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentOrange}" Opacity="0.9"/>
                                <Ellipse Canvas.Left="102" Canvas.Top="2" Width="30" Height="30" Fill="{StaticResource AccentOrange}"/>
                                <Path Data="M 117,10 L 117,24 M 110,17 L 124,17" Stroke="{DynamicResource ThemeText}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="아직 관리 툴이 없어요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="빈 곳을 더블클릭하거나 ‘+ 새 관리 툴’을 눌러 시작하세요" FontSize="13" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Zoom controls + the Ctrl hint next to them -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="24,0,0,24">
                        <!-- Glass look (design #7): translucent gradient, hairline border and a soft shadow instead of a solid bar -->
                        <Border CornerRadius="17" Padding="4" BorderBrush="{DynamicResource Fg40}" BorderThickness="1">
                            <Border.Resources>
                            <ResourceDictionary Source="/ProjectManagementBoard;component/Themes/OnDark.xaml"/>
                        </Border.Resources>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#9E26407A" Offset="0"/>
                                    <GradientStop Color="#9E111D38" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#050A18" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="축소 (Ctrl+-)"
                                        Click="ZoomOut_Click"/>
                                <Button Style="{StaticResource GhostButton}" Padding="6,3" MinWidth="58" ToolTip="100%로 (Ctrl+0)"
                                        Click="ZoomReset_Click">
                                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="확대 (Ctrl++)"
                                        Click="ZoomIn_Click"/>
                                <Border Width="1" Margin="6,6" Background="{DynamicResource Fg33}"/>
                                <Button Style="{StaticResource GhostButton}" Padding="8,3" ToolTip="모든 관리 툴과 그룹이 보이게 (Ctrl+1)"
                                        Click="FitAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="전체 보기" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Ctrl always means the board, even over a docked tool (MainWindow.BoardOverride). Mouse never stops here. -->
                        <!-- Same glass pill as the zoom bar (always dark, white text) so it stays readable over cards -->
                        <Border VerticalAlignment="Center" Margin="10,0,0,0" CornerRadius="14" Padding="12,6"
                                BorderBrush="{DynamicResource Fg40}" BorderThickness="1" IsHitTestVisible="False"
                                TextElement.Foreground="White">
                            <Border.Resources>
                                <ResourceDictionary Source="/ProjectManagementBoard;component/Themes/OnDark.xaml"/>
                            </Border.Resources>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#9E26407A" Offset="0"/>
                                    <GradientStop Color="#9E111D38" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock FontSize="12">
                                <Run Text="Ctrl + 휠" FontWeight="SemiBold"/><Run Text="  확대/축소" Foreground="{DynamicResource FgD0}"/>
                                <Run Text="  ·  " Foreground="{DynamicResource Fg66}"/>
                                <Run Text="Ctrl + 우클릭 드래그" FontWeight="SemiBold"/><Run Text="  화면 이동" Foreground="{DynamicResource FgD0}"/>
                                <Run Text="  (관리 툴 위에서도)" Foreground="{DynamicResource Fg99}"/>
                            </TextBlock>
                        </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Undo toast -->
                    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,28" Padding="18,8,8,8" CornerRadius="16" Background="#F0111D38"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Resources>
                            <ResourceDictionary Source="/ProjectManagementBoard;component/Themes/OnDark.xaml"/>
                        </Border.Resources>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastShift" Y="24"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#050A18" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastText" FontSize="13" VerticalAlignment="Center"/>
                            <Button x:Name="ToastUndoButton" Style="{StaticResource GhostButton}" Content="실행 취소" Foreground="{DynamicResource AccentYellow}"
                                    FontWeight="SemiBold" Margin="14,0,0,0" ToolTip="Ctrl+Z" Click="Undo_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Edit popup (covers everything below the title bar, so the window can still be moved/closed) -->
                <c:EditorOverlay x:Name="Editor" Grid.ColumnSpan="2"/>

            </Grid>
        </Grid>
    </Border>
</Window>
