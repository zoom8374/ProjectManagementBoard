<UserControl x:Class="ProjectManagementBoard.Controls.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ProjectManagementBoard.Controls"
             Foreground="{DynamicResource ThemeText}" Opacity="0" RenderTransformOrigin="0.5,0.5" FocusVisualStyle="{x:Null}">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="GroupScale"/>
    </UserControl.RenderTransform>

    <!-- Only the header and resize grip are hit-testable, so the body lets clicks through to the board
         (panning, double-click to add a card into the group). -->
    <Grid>
        <Border x:Name="Fill" CornerRadius="26" IsHitTestVisible="False" Opacity="0.6">
            <Border.Background>
                <SolidColorBrush x:Name="FillBrush"/>
            </Border.Background>
        </Border>
        <Rectangle x:Name="Outline" RadiusX="26" RadiusY="26" StrokeThickness="2" StrokeDashArray="5 4"
                   IsHitTestVisible="False" Opacity="0.7">
            <Rectangle.Stroke>
                <SolidColorBrush x:Name="OutlineBrush"/>
            </Rectangle.Stroke>
        </Rectangle>

        <!-- Header band (design #4): a light wash fading downward behind the title, with a hairline under it
             that fades at both ends, so the group's title area reads as its header. Visual only. -->
        <Border VerticalAlignment="Top" Height="56" CornerRadius="26,26,0,0" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#26FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Rectangle VerticalAlignment="Top" Height="1" Margin="28,56,28,0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#40FFFFFF" Offset="0.2"/>
                    <GradientStop Color="#40FFFFFF" Offset="0.8"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Header: drag handle + title -->
        <Grid x:Name="Header" VerticalAlignment="Top" Height="50" Margin="12,6,12,0" Background="Transparent"
              Cursor="SizeAll" ToolTip="드래그하면 안의 관리 툴과 함께 이동">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse Width="11" Height="11" Margin="8,0,6,0" VerticalAlignment="Center" Fill="{Binding Color}"/>
            <c:EditableText Grid.Column="1" Field="GroupTitle" Placeholder="그룹 이름" Text="{Binding Title}"
                            FontSize="{Binding TitleFontSize}" FontWeight="Bold" MaxWidth="420"/>
            <TextBlock x:Name="CountText" Grid.Column="2" FontSize="12" Opacity="0.65"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <StackPanel x:Name="GroupActions" Grid.Column="4" Orientation="Horizontal" Opacity="0">
                <Button Style="{StaticResource IconButton}" ToolTip="그룹 색상" Click="GroupColor_Click">
                    <Ellipse Width="13" Height="13" Fill="{Binding Color}" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.5"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="그룹 삭제 (관리 툴은 유지)"
                        Click="Delete_Click"/>
            </StackPanel>
        </Grid>

        <!-- Resize handle -->
        <Border x:Name="ResizeGrip" Width="26" Height="26" Margin="0,0,8,8"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="SizeNWSE" Opacity="0.35" ToolTip="드래그해서 크기 조절"
                MouseEnter="ResizeGrip_MouseEnter" MouseLeave="ResizeGrip_MouseLeave"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" LostMouseCapture="ResizeGrip_LostMouseCapture">
            <Path Data="M 20,6 L 6,20 M 20,12 L 12,20 M 20,18 L 18,20" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
    </Grid>
</UserControl>
