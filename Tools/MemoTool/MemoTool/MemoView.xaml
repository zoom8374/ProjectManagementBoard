<UserControl x:Class="MemoTool.MemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Transparent so the card's color shows through; the card is always dark, so the text is white. -->
    <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
             Foreground="White" CaretBrush="White" FontSize="17" Padding="12"
             FontFamily="Segoe UI, Malgun Gothic"/>
</UserControl>
