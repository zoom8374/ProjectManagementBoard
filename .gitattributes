# Normalize line endings in the repository; working copies on Windows get CRLF.
* text=auto

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.slnx    text eol=crlf
*.ps1     text eol=crlf
*.md      text
*.yml     text eol=lf

# Binary
*.ico binary
*.png binary
*.jpg binary
